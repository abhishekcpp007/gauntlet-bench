/* The Dataset screen: numbers, the funnel and repo charts, then the set's tasks. */

#dataset-headline {
    height: 3;
    padding: 1 1 0 1;
}

#dataset-headline Stat {
    margin-right: 3;
}

#dataset-about {
    padding: 0 1;
    margin-bottom: 1;
}

#dataset-charts {
    max-height: 30%;
    min-height: 5;
}

.chart {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.chart > VerticalScroll {
    height: 1fr;
}

#dataset-tasks {
    min-height: 8;
}
