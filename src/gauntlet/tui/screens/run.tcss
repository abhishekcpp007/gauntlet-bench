/* Run: the facts and trust numbers on top, the tabs below. */

RunScreen #run-top {
    height: auto;
    padding: 1 1 0 1;
}

RunScreen #run-facts {
    padding: 0;
}

RunScreen #run-stats {
    width: 21;
    height: auto;
    padding: 0 0 0 4;
}

RunScreen TabPane > .pane {
    height: 1fr;
}

RunScreen.-short #run-stats {
    layout: horizontal;
    width: 47;
}

RunScreen.-short #run-stats Stat {
    margin-right: 3;
}

RunScreen #run-tabs {
    margin-top: 1;
}

RunScreen.-short #run-tabs {
    margin-top: 0;
}
