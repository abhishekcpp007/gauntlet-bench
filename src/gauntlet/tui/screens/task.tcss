/* The Task screen: facts in two columns, then the tabs. */

#task-facts {
    height: auto;
    padding: 1 1 0 1;
}

#task-facts Facts {
    width: 1fr;
    padding: 0 1;
}

#task-line {
    display: none;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    padding: 0 1;
}

#task-tabs {
    margin-top: 1;
}

TaskScreen.-compact #task-facts {
    display: none;
}

TaskScreen.-compact #task-line {
    display: block;
}

TaskScreen.-compact #task-tabs {
    margin-top: 0;
}

TaskScreen.-compact #patches > Deferred > .intro {
    margin: 0;
}

#statement-text {
    padding-bottom: 1;
}

#tests-split {
    height: 1fr;
}

#tests-summary {
    width: 1fr;
}

#p2p-pane {
    width: 1fr;
    height: 1fr;
}

#patches > Deferred > .intro {
    margin: 1 0;
}

.patch {
    height: 1fr;
}

#episodes-pane {
    margin-top: 1;
}
